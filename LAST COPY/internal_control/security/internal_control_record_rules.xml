            <field name="model_id" ref="model_survey_survey"/>
            <field name="domain_force">['|',('department_id','=',user.employee_id.department_id.id),('department_id','=',False)]</field>
            <field name="groups" eval="[(4, ref('internal_control.internal_control_admin'))]"/>
        </record>
