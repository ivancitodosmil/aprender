<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Reporte de Items Revisados -->
        <record id="action_report_survey_revised_items" model="ir.actions.report">
            <field name="name">Reporte Items Revisados</field>
            <field name="model">survey.revised.items</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">internal_control.report_survey_revised_items</field>
            <field name="report_file">internal_control.report_survey_revised_items</field>
            <field name="print_report_name">'Reporte Items Revisados - %s' % (object.survey_id.title)</field>
            <field name="binding_model_id" ref="model_survey_revised_items"/>
            <field name="binding_type">report</field>
        </record>

