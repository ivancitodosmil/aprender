                <form string="Importar Estructura de Encuesta">
                    <group>
                        <field name="archivo_json" filename="nombre_archivo"/>
                        <field name="nombre_archivo" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_importar" type="object" string="Importar" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_survey_dates_form" model="ir.ui.view">
            <field name="name">survey.dates.form</field>
            <field name="model">survey.dates</field>
            <field name="arch" type="xml">
                <form string="Programar encuesta">
                    <group>
                        <field name="name" placeholder="Ej: Evaluación trimestral, Satisfacción 2024, etc."/>
                        <field name="survey_id"/>
                        <field name="department_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="employee_ids"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_survey_question_form_inherit_image_upload" model="ir.ui.view">
            <field name="name">survey.question.form.inherit.image_upload</field>
            <field name="model">survey.question</field>
            <field name="inherit_id" ref="survey.survey_question_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='question_type']" position="after">
                    <!-- No extra fields needed, just ensure the type is selectable -->
                </xpath>
                <xpath expr="//div[@class='mx-lg-auto w-lg-50 d-none d-sm-block o_preview_questions bg-light']" position="inside">
                    <!-- Image Upload Preview -->
                    <div invisible="question_type != 'image_upload'">
                        <span>Upload an image as your answer</span><br/>
                        <i class="fa fa-image fa-4x" role="img" aria-label="Image Upload" title="Image Upload"/>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- New tree view for answer lines, showing the image for image_upload type -->
        <record id="internal_control_survey_user_input_line_tree" model="ir.ui.view">
            <field name="name">survey.user_input.line.tree.image</field>
            <field name="model">survey.user_input.line</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="question_id"/>
                    <field name="answer_type"/>
                    <field name="value_char_box"/>
                    <field name="value_numerical_box"/>
                    <field name="value_date"/>
                    <field name="value_datetime"/>
                    <field name="value_image" widget="image"/>
                </tree>
            </field>
        </record>

        <!-- Inherit the participation form to use the new tree view for answer lines -->
        <record id="internal_control_survey_user_input_form_inherit" model="ir.ui.view">
            <field name="name">survey.user_input.form.inherit.image</field>
            <field name="model">survey.user_input</field>
            <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_input_line_ids']" position="attributes">
                    <attribute name="tree_view_ref">internal_control_survey_user_input_line_tree</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 